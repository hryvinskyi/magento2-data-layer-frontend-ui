<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The Google Ads conversion comes right after the purchase it reports -->
        <referenceBlock name="hryvinskyi.datalayer.bootstrap">
            <arguments>
                <argument name="page_event_sources" xsi:type="array">
                    <item name="purchase" xsi:type="object">Hryvinskyi\DataLayerFrontendUi\ViewModel\PageEvent\Purchase</item>
                    <item name="ads_conversion" xsi:type="object">HryvinskyiDataLayerAdsConversionPageEvent</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
