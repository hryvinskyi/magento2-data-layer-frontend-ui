<!-- The data layer's storefront endpoints; a module that adds endpoints of its own joins this route -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <route id="hryvinskyi_datalayer" frontName="hryvinskyi_datalayer">
            <module name="Hryvinskyi_DataLayerFrontendUi"/>
        </route>
    </router>
</config>
