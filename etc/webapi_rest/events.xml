<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Server events queued by the storefront's REST calls (the checkout steps) are signalled on the response
         when no page cache may store it -->
    <event name="controller_front_send_response_before">
        <observer name="hryvinskyi_datalayer_send_server_event_signal"
                  instance="Hryvinskyi\DataLayerFrontendUi\Observer\SendServerEventSignal"/>
    </event>
</config>
